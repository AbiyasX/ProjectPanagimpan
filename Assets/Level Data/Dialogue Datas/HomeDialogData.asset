--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7adab9d9ef604e42af226d41cf88436, type: 3}
  m_Name: HomeDialogData
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogue_Background: {fileID: 0}
  dialogue_Texts:
  - speakerType: 0
    dialogueSpeaker: Narrator
    dialogueText: At the {player1}'s home, the two friends are getting ready to go
      to school.
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 1
    dialogueSpeaker: 
    dialogueText: Do you have everything you need?
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 2
    dialogueSpeaker: 
    dialogueText: I do! How about you?
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 1
    dialogueSpeaker: 
    dialogueText: "I\u2019m ready!"
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 0
    dialogueSpeaker: PARENT
    dialogueText: "{player1}! Don\u2019t forget to bring the spaghetti I cooked for
      you and your friends!"
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 1
    dialogueSpeaker: 
    dialogueText: "Oh that\u2019s right!"
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 1
    dialogueSpeaker: 
    dialogueText: We need that so we have something to bring to the festival!
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 2
    dialogueSpeaker: 
    dialogueText: Maybe on the way, we can get some more things!
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerType: 1
    dialogueSpeaker: 
    dialogueText: Yeah! Our friends would love that.
    OnTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  startTriggerEvent:
    m_PersistentCalls:
      m_Calls: []
  endTriggerEvent:
    m_PersistentCalls:
      m_Calls: []
